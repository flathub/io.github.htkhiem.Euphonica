{
    "id": "io.github.htkhiem.Euphonica",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "command": "euphonica",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-run/pipewire-0:ro"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "modules": [
        {
            "name": "soxr",
            "buildsystem": "cmake",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/chirlu/soxr/archive/refs/tags/0.1.3.tar.gz",
                    "sha256": "db6ca1b1e8405c6ef92f8294fc123d910abf0a114003b3f0f13fa57a95fd62d0"
                }
            ]
        },
        {
            "name": "id3tag",
            "buildsystem": "cmake",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://codeberg.org/tenacityteam/libid3tag/releases/download/0.16.4/id3tag-0.16.4-source.tar.gz",
                    "sha256": "8b6bc96016f6ab3a52b753349ed442e15181de9db1df01884f829e3d4f3d1e78"
                }
            ]
        },
        {
            "name": "mpd",
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/MusicPlayerDaemon/MPD/archive/refs/tags/v0.24.15.tar.gz",
                    "sha256": "448172fcd26aa6eb8bfe95c998cf7bd612ae6beaf5ba54f2cbf984d0249d3de4"
                }
            ],
            "post-install": [
                "mpd --version"
            ]
        },
        {
            "name": "euphonica",
            "builddir": true,
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/htkhiem/euphonica.git",
                    "commit": "1372877f3640a5a21543f69e72109b985bfbc629"
                },
                "cargo-sources.json",
                {
                    "type": "shell",
                    "commands": [
                        "mkdir -p .cargo",
                        "cp -vf cargo/config .cargo/"
                    ]
                }
            ],
            "build-options": {
                "env": {
                    "CARGO_NET_OFFLINE": "true"
                },
                "append-path": "/usr/lib/sdk/llvm22/bin",
                "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib"
            }
        }
    ]
}